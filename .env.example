APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Legacy SSO settings retained for existing integration points.
SSO_BASE_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_CATEGORIES_PATH=/api/get_kode_kegiatan
SSO_ADMIN_NIP=elearning
SSO_ADMIN_USERNAME=elearning
PRESTIGE_SUPER_ADMIN_EMAIL=genz.developt@gmail.com

# Kedaton OAuth 2.0. Register KEDATON_REDIRECT_URI exactly with Kedaton.
# Never place client_secret, data_key, access tokens, passwords, or OTPs in Git.
KEDATON_BASE_URL=https://kedaton.gresikkab.go.id
KEDATON_CLIENT_ID=
KEDATON_CLIENT_SECRET=
KEDATON_REDIRECT_URI="${APP_URL}/auth/kedaton/callback"
KEDATON_SCOPE=
KEDATON_DATA_KEY=
KEDATON_DATA_TYPE=pns

# Temporary local-only admin access while authentication is being developed.
# This is ignored outside APP_ENV=local/testing and must remain false in production.
DEV_ADMIN_BYPASS=false
# Optional: set an existing Admin user ID. Leave blank to use the first Admin user.
DEV_ADMIN_USER_ID=

# Backup encryption: create the age identity on an OFFLINE recovery machine.
# Copy only its public age1... recipient here. No plaintext fallback is allowed.
BACKUP_AGE_RECIPIENTS=
BACKUP_AGE_BINARY=age
# Configure a dedicated private filesystem disk. Production requires off-site copy.
BACKUP_REMOTE_DISK=
BACKUP_REMOTE_PREFIX=gapura
BACKUP_REQUIRE_REMOTE=true
BACKUP_ALERT_EMAIL=
BACKUP_DAILY_KEEP=7
BACKUP_WEEKLY_KEEP=4
BACKUP_FILES_KEEP=7
LOG_BACKUP_KEEP=30
LOG_DAILY_DAYS=14
LOG_AUTH_DAYS=30
LOG_BACKUP_DAYS=30
BACKUP_TIMEOUT=3600

# Set BACKUP_REMOTE_DISK=backup_s3 after provisioning a PRIVATE off-site bucket.
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_DEFAULT_REGION=ap-southeast-1
BACKUP_AWS_BUCKET=
BACKUP_AWS_ENDPOINT=
BACKUP_AWS_USE_PATH_STYLE_ENDPOINT=false
