							"raw": "{{base_url}}/categories/:id/courses?per_page=15",
							"host": ["{{base_url}}"],
							"path": ["categories", ":id", "courses"],
							"query": [
								{
									"key": "per_page",
									"value": "15",
									"description": "Jumlah data per halaman"
								}
							],
							"variable": [
								{
									"key": "id",
									"value": "1",
									"description": "ID kategori"
								}
							]
						},
						"description": "Mengambil daftar pelatihan berdasarkan kategori tertentu."
					}
				}
			]
		},
		{
