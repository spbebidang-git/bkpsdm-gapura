							"raw": "{{base_url}}/categories",
							"host": ["{{base_url}}"],
							"path": ["categories"]
						},
						"description": "Mengambil daftar semua kategori pelatihan beserta jumlah course."
					}
				},
				{
					"name": "Courses by Category",
					"request": {
						"method": "GET",
						"header": [],
