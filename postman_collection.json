					}
				}
			]
		},
		{
			"name": "📈 Statistics (Statistik)",
			"item": [
				{
					"name": "Platform Overview",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/statistics/overview",
							"host": ["{{base_url}}"],
							"path": ["statistics", "overview"]
						},
						"description": "Ringkasan statistik platform secara keseluruhan:\ntotal courses, participants, instructors, enrollments, completion rate, average rating."
					}
				},
				{
					"name": "Yearly Statistics",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/statistics/yearly?year=2026",
							"host": ["{{base_url}}"],
							"path": ["statistics", "yearly"],
							"query": [
